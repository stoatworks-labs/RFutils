{
  "name": "RFutils",
  "short_name": "RFutils",
  "description": "A browser RF suite for radio mics: Wireless Workbench, WSM and Ofcom PMSE file exchange, plus IM-aware frequency coordination.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#12141a",
  "theme_color": "#12141a",
  "orientation": "any",
