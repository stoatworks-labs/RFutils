{
  "name": "@rfutils/web",
  "version": "0.4.4",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:static": "tsc -p tsconfig.json && VITE_RFUTILS_STATIC=1 vite build",
    "preview:static": "VITE_RFUTILS_STATIC=1 vite preview --outDir dist-static"
  },
  "dependencies": {
    "@rfutils/shared": "*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.0",
    "typescript": "^5.6.3",
    "vite": "^8.2.2"
  }
}
